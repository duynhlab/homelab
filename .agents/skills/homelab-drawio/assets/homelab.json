{
  "name": "homelab",
  "version": 2,
  "_source": "Semantic colours mirror the Mermaid classDef palette in AGENTS.md (Docs conventions -> Diagram workflow, step 4). A Draw.io node and the Mermaid diagram beside it must read as one system, so fill/stroke/font are copied from the classDef verbatim, not re-invented. Change AGENTS.md and this file together. v2 (2026-09-28): soft tints — a light fill, the role hue on the stroke, dark text; every role clears 7:1 text contrast and 3:1 stroke contrast (checked with the WCAG formula). The saturated v1 fills with white text read as heavy on large diagrams.",
  "font": {
    "fontFamily": "Helvetica",
    "fontSize": 11,
    "titleFontSize": 13,
    "titleColor": "#334155"
  },
  "roles": {
    "edge": {
      "fillColor": "#DBEAFE",
      "strokeColor": "#2563EB",
      "fontColor": "#1E3A8A",
      "note": "gateway / edge"
    },
    "service": {
      "fillColor": "#CFFAFE",
      "strokeColor": "#0891B2",
      "fontColor": "#164E63",
      "note": "platform / app service"
    },
    "worker": {
      "fillColor": "#FEF3C7",
      "strokeColor": "#D97706",
      "fontColor": "#78350F",
      "note": "worker / async processor"
    },
    "platform": {
      "fillColor": "#EDE9FE",
      "strokeColor": "#7C3AED",
      "fontColor": "#4C1D95",
      "note": "control-plane / platform controller"
    },
    "data": {
      "fillColor": "#DCFCE7",
      "strokeColor": "#16A34A",
      "fontColor": "#14532D",
      "note": "datastore"
    },
    "external": {
      "fillColor": "#F1F5F9",
      "strokeColor": "#64748B",
      "fontColor": "#334155",
      "note": "external / third-party"
    },
    "metric": {
      "fillColor": "#FFE8CC",
      "strokeColor": "#E8590C",
      "fontColor": "#111111",
      "note": "observability: metrics"
    },
    "log": {
      "fillColor": "#D3F9D8",
      "strokeColor": "#2F9E44",
      "fontColor": "#111111",
      "note": "observability: logs"
    },
    "trace": {
      "fillColor": "#C5F6FA",
      "strokeColor": "#0C8599",
      "fontColor": "#111111",
      "note": "observability: traces"
    },
    "profile": {
      "fillColor": "#F3D9FA",
      "strokeColor": "#9C36B5",
      "fontColor": "#111111",
      "note": "observability: profiles"
    },
    "collector": {
      "fillColor": "#E0F2FE",
      "strokeColor": "#1971C2",
      "fontColor": "#0C4A6E",
      "note": "observability: collector"
    },
    "planned": {
      "fillColor": "#FFFFFF",
      "strokeColor": "#64748B",
      "fontColor": "#475569",
      "dashed": true,
      "note": "planned / not-yet-deployed"
    }
  },
  "_shapes_note": "container=1 is load-bearing, not decoration: a frame must OWN its children so moving it moves them, and so the 'no logo on a grouping frame' check has something to fire on. Children of a container carry mxGeometry RELATIVE to the frame origin. collapsible=0 keeps the fold arrow out of an architecture diagram. For an untitled invisible group, Draw.io's own mechanism is the `group;` style instead.",
  "shapes": {
    "card": "rounded=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;",
    "container": "rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;html=1;container=1;collapsible=0;",
    "datastore": "shape=cylinder3;whiteSpace=wrap;html=1;shadow=0;"
  },
  "label_style": "shape=label;rounded=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;image=data:image/png,{payload};imageAlign=left;imageVerticalAlign=middle;imageWidth=24;imageHeight=24;spacingLeft=42;align=left;{dashed}fillColor={fillColor};strokeColor={strokeColor};strokeWidth=1.5;fontColor={fontColor};fontFamily={fontFamily};fontSize={fontSize};",
  "plain_style": "rounded=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor={fillColor};strokeColor={strokeColor};strokeWidth=1.5;fontColor={fontColor};fontFamily={fontFamily};fontSize={fontSize};",
  "edges": {
    "request": "edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=1.5;endArrow=classic;",
    "storage": "edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=1.5;endArrow=classic;",
    "scaling": "edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=1.5;endArrow=classic;",
    "planned": "edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=open;dashed=1;",
    "request_animated": "edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=1.5;endArrow=classic;flowAnimation=1;"
  },
  "_edges_note": "flowAnimation=1 animates the dashes along the connector to show flow direction. It moves only in SVG and in the Draw.io editor -- a PNG export is static, and GitHub may strip the animation from an embedded SVG. Use it sparingly, on the diagram's primary flow only; append ';flowAnimation=1;' to any edge role to animate it.",
  "frame": {
    "fillColor": "#F8FAFC",
    "strokeColor": "#CBD5E1",
    "fontColor": "#334155",
    "strokeWidth": 1.5,
    "fontSize": 13,
    "fontStyle": 1,
    "note": "the neutral frame every domain group and the legend use; frames never take a role colour or a logo"
  },
  "_shadow_note": "No drop shadows (v2): on a canvas of 30+ boxes a shadow per box adds weight without meaning. Hierarchy comes from frames and strokes."
}
