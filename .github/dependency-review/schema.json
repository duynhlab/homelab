{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/duynhlab/homelab/.github/dependency-review/schema.json",
  "title": "Dependency review v1",
  "description": "One AI review of one Renovate pull request. Written by the review job, validated and rendered by post.mjs, mirrored by dep-radar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pr",
    "head_sha",
    "reviewed_at",
    "prompt_version",
    "model",
    "dependency",
    "verdict",
    "impact",
    "summary",
    "breaking",
    "affected_files",
    "verification",
    "related_prs",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pr": { "type": "integer", "minimum": 1 },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "prompt_version": { "type": "integer", "minimum": 1 },
    "model": { "type": "string", "minLength": 1 },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "manager", "update_type", "from", "to"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "manager": { "type": "string", "minLength": 1 },
        "update_type": { "enum": ["digest", "patch", "minor", "major", "pin"] },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "notes_truncated": { "type": "boolean" },
        "first_party": { "type": "boolean" }
      }
    },
    "verdict": { "enum": ["safe-static", "safe-for-repo-use", "hold"] },
    "hold_reason": {
      "enum": [
        "behavior-migration-verification",
        "hidden-dependency-version-alignment",
        "secret-output-validation",
        "image-level-bootstrap-proof",
        "existing-state-migration-proof",
        "telemetry-behavior-verification",
        "persistent-state-migration-rollback",
        "query-behavior-operations-docs",
        "confirmed-repo-breaking-change",
        "other"
      ]
    },
    "impact": { "enum": ["none", "minor", "breaking"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "breaking": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "relevant", "why"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "relevant": { "type": "boolean" },
          "why": { "type": "string", "minLength": 1 },
          "version": { "type": "string" },
          "evidence_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "useful_for_homelab": { "type": "boolean" },
          "why": { "type": "string" },
          "evidence_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "affected_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["pin", "manifest", "values", "compose", "terraform", "script", "docs", "policy"] },
          "note": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "kind"],
        "properties": {
          "step": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["static", "runtime", "docs"] }
        }
      }
    },
    "related_prs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "relationship"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "relationship": { "enum": ["same-family", "must-land-together", "chart-of", "image-of", "order-after"] },
          "note": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
