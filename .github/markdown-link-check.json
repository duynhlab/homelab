{
  "ignorePatterns": [
    {
      "pattern": "^https?://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?(?:/|$)"
    },
    {
      "pattern": "^https?://[^/]+\\.duynh\\.me(?:/|$)"
    },
    {
      "pattern": "^https://karma-dashboard\\.io/"
    },
    {
      "pattern": "(RFC-NNNN|ADR-NNN|%7B[a-z]+%7D|\\{[a-z]+\\})"
    }
  ],
  "httpHeaders": [
    {
      "urls": [
        "https://github.com/",
        "https://docs.github.com/"
      ],
      "headers": {
        "Accept-Encoding": "zstd, br, gzip, deflate"
      }
    }
  ],
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "10s"
}
