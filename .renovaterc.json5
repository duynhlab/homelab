{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    // ":automergeBranch",
    // ":automergeMinor",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
    ":timezone(Asia/Ho_Chi_Minh)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard",
  flux: {
    managerFilePatterns: [
      "/^kubernetes/.+\\.yaml$/",
    ],
  },
  "helm-values": {
    managerFilePatterns: [
      "/^kubernetes/.+\\.yaml$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      "/^kubernetes/.+\\.yaml$/",
    ],
  },
  customManagers: [
    {
      // grafana-clickhouse-datasource: the plugin pin and the URL tag of its
      // dashboards move together (packageRules groups them into one PR).
      customType: "regex",
      managerFilePatterns: [
        "/^kubernetes/infra/configs/observability/grafana/grafana\\.yaml$/",
        "/^kubernetes/infra/configs/observability/grafana/dashboards/grafana-dashboard-clickhouse-upstream\\.yaml$/",
        "/^local-stack/compose\\.yaml$/",
      ],
      matchStrings: [
        "grafana-clickhouse-datasource (?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "grafana/clickhouse-datasource/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/",
      ],
      depNameTemplate: "grafana/clickhouse-datasource",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.*)$",
    },
    {
      // The Kind node image in scripts/kind-up.sh, pinned by tag and digest
      // (RFC-0032). The regex takes the line after the `# renovate:` comment.
      customType: "regex",
      managerFilePatterns: ["/^scripts/kind-up\\.sh$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^\\n]*?:(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
    },
  ],
  packageRules: [
    {
      matchPackageNames: ["grafana/clickhouse-datasource"],
      groupName: "grafana-clickhouse-datasource",
    },
    {
      // Patch and digest bumps only. A Kubernetes minor is a cluster
      // recreation with its own gate (RFC-0032), and a node image newer than
      // the Kind CLI supports fails at create time.
      matchDatasources: ["docker"],
      matchPackageNames: ["kindest/node"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    {
      // Hold Tempo on 2.x. Tempo 3.0 removed the `ingester` and `compactor`
      // modules, so the major is a hand-written config migration (drop both
      // blocks, re-home the 168h block_retention) that a version bump cannot
      // express — and the single-binary `grafana-community/tempo` chart has no
      // 3.x appVersion to migrate to. The raw install this pin protects is
      // scheduled for deletion by ADR-040 phase 2; revisit then.
      matchDatasources: ["docker"],
      matchPackageNames: ["grafana/tempo"],
      allowedVersions: "<3",
    },
  ],
}
