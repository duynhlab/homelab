      <mxCell id="title" value="duynhlab homelab — Observability delivery order" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1000" height="28" as="geometry" /></mxCell><mxCell id="subtitle" value="How Flux delivers the observability stack, and what releases each wave. Every arrow is a Flux &lt;b&gt;dependsOn&lt;/b&gt;; the third line of each box is that wave's gate. Runtime signal flow is a different question — see the fan-out map at the top of this page." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="34" as="geometry" /></mxCell><mxCell id="f_legend" value="Legend" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;html=1;container=1;collapsible=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#334155;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="947" width="520" height="176" as="geometry" /></mxCell><mxCell id="lg_s0" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#7C3AED;strokeColor=#5B21B6;strokeWidth=1.5;" vertex="1" parent="f_legend"><mxGeometry x="20" y="42" width="18" height="14" as="geometry" /></mxCell><mxCell id="lg_t0" value="Control plane / secrets / storage" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_legend"><mxGeometry x="46" y="39" width="210" height="20" as="geometry" /></mxCell><mxCell id="lg_s1" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#FFE8CC;strokeColor=#E8590C;strokeWidth=1.5;" vertex="1" parent="f_legend"><mxGeometry x="20" y="72" width="18" height="14" as="geometry" /></mxCell><mxCell id="lg_t1" value="Metrics + Grafana config" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_legend"><mxGeometry x="46" y="69" width="210" height="20" as="geometry" /></mxCell><mxCell id="lg_s2" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#22C55E;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="f_legend"><mxGeometry x="20" y="102" width="18" height="14" as="geometry" /></mxCell><mxCell id="lg_t2" value="Datastore (ClickHouse)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_legend"><mxGeometry x="46" y="99" width="210" height="20" as="geometry" /></mxCell><mxCell id="lg_s3" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#F59E0B;strokeColor=#B45309;strokeWidth=1.5;" vertex="1" parent="f_legend"><mxGeometry x="20" y="132" width="18" height="14" as="geometry" /></mxCell><mxCell id="lg_t3" value="One-shot Job" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_legend"><mxGeometry x="46" y="129" width="210" height="20" as="geometry" /></mxCell><mxCell id="lg_s4" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#A5D8FF;strokeColor=#1971C2;strokeWidth=1.5;" vertex="1" parent="f_legend"><mxGeometry x="270" y="42" width="18" height="14" as="geometry" /></mxCell><mxCell id="lg_t4" value="Collector" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_legend"><mxGeometry x="296" y="39" width="210" height="20" as="geometry" /></mxCell><mxCell id="lg_s5" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#F3D9FA;strokeColor=#9C36B5;strokeWidth=1.5;" vertex="1" parent="f_legend"><mxGeometry x="270" y="72" width="18" height="14" as="geometry" /></mxCell><mxCell id="lg_t5" value="Profiles" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_legend"><mxGeometry x="296" y="69" width="210" height="20" as="geometry" /></mxCell><mxCell id="lg_s6" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;fillColor=#06B6D4;strokeColor=#0E7490;strokeWidth=1.5;" vertex="1" parent="f_legend"><mxGeometry x="270" y="102" width="18" height="14" as="geometry" /></mxCell><mxCell id="lg_t6" value="Application wave" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_legend"><mxGeometry x="296" y="99" width="210" height="20" as="geometry" /></mxCell><mxCell id="lg_arrow" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=1.5;endArrow=classic;" edge="1" parent="f_legend"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="141" as="sourcePoint" /><mxPoint x="300" y="141" as="targetPoint" /></mxGeometry></mxCell><mxCell id="lg_arrow_t" value="Flux &lt;b&gt;dependsOn&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_legend"><mxGeometry x="306" y="131" width="200" height="20" as="geometry" /></mxCell><mxCell id="note_gate" value="&lt;b&gt;Reading the gate line&lt;/b&gt;&lt;br&gt;&lt;b&gt;wait&lt;/b&gt; — the wave is Ready when the objects &lt;i&gt;it applies&lt;/i&gt; are Ready.&lt;br&gt;&lt;b&gt;healthChecks&lt;/b&gt; (bold in the box) — &lt;b&gt;wait is deliberately absent.&lt;/b&gt; The objects worth gating on are StatefulSets and GrafanaManifests an operator creates later, so they are never in the wave's own applied set and &lt;b&gt;wait&lt;/b&gt; would pass instantly. Listing them is the only thing that holds the next wave back (RFC-0028 / ADR-065).&lt;br&gt;The two are mutually exclusive and &lt;b&gt;wait&lt;/b&gt; wins, so a wave setting both gates only on what it applies." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="590" y="947" width="900" height="124" as="geometry" /></mxCell><mxCell id="note_src" value="&lt;b&gt;Sources&lt;/b&gt; — every wave reads &lt;b&gt;infrastructure-oci&lt;/b&gt; (oci://homelab-registry:5000/flux-infra-sync, ref &lt;i&gt;local&lt;/i&gt;) except the two dashboards-as-code waves, which read &lt;b&gt;grafana-dashboards-as-code-oci&lt;/b&gt; (ghcr.io/duynhlab/grafana-dashboards-as-code, semver 0.2.0)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="590" y="1043" width="900" height="44" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>
