<mxfile host="homelab-drawio"><diagram id="signal-flow" name="Signal flow"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="duynhlab homelab — Observability signal flow and retention" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="26" as="geometry"/></mxCell><mxCell id="subtitle" value="Where every signal goes on the cluster: which OTel Collector pipeline carries it, which backend stores it, and for how long. Delivery order (Flux waves) is a different question — see observability-delivery.drawio." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="34" as="geometry"/></mxCell><mxCell id="f_src" value="Producers — through the collector" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;html=1;container=1;collapsible=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#334155;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="330" as="geometry"/></mxCell><mxCell id="svc" value="Go services ×10 · order-worker · checkout-worker · mockpay" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;image=data:image/png,;imageAlign=left;imageVerticalAlign=middle;imageWidth=24;imageHeight=24;spacingLeft=42;align=left;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=1.5;fontColor=#164E63;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="f_src"><mxGeometry x="20" y="50" width="280" height="64" as="geometry"/></mxCell><mxCell id="edge" value="Envoy Gateway (edge proxy)" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;image=data:image/png,;imageAlign=left;imageVerticalAlign=middle;imageWidth=24;imageHeight=24;spacingLeft=42;align=left;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#1E3A8A;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="f_src"><mxGeometry x="20" y="170" width="280" height="50" as="geometry"/></mxCell><mxCell id="src_note" value="Traces, metrics and logs from the fleet; spans and access logs from the edge." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_src"><mxGeometry x="20" y="250" width="280" height="40" as="geometry"/></mxCell><mxCell id="f_side" value="Producers — straight to a backend" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;html=1;container=1;collapsible=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#334155;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="320" height="300" as="geometry"/></mxCell><mxCell id="pyrosdk" value="Same Go processes — Pyroscope SDK" style="shape=label;rounded=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;image=data:image/png,;imageAlign=left;imageVerticalAlign=middle;imageWidth=24;imageHeight=24;spacingLeft=42;align=left;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=1.5;fontColor=#164E63;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="f_side"><mxGeometry x="20" y="50" width="280" height="50" as="geometry"/></mxCell><mxCell id="targets" value="Scrape targets: kube-state-metrics · cAdvisor · CNPG · Temporal · exporters" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFE8CC;strokeColor=#E8590C;strokeWidth=1.5;fontColor=#111111;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="f_side"><mxGeometry x="20" y="125" width="280" height="64" as="geometry"/></mxCell><mxCel