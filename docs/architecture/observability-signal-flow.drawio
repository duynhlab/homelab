der (Grafana)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_legend"><mxGeometry x="426" y="98" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg_a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=1.5;endArrow=classic;" edge="1" parent="f_legend"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="50" as="sourcePoint"/><mxPoint x="640" y="50" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_ta1" value="signal sent / read (blue) · read by Grafana (slate)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_legend"><mxGeometry x="648" y="40" width="160" height="34" as="geometry"/></mxCell><mxCell id="lg_a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=1.5;endArrow=classic;" edge="1" parent="f_legend"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="100" as="sourcePoint"/><mxPoint x="640" y="100" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg_ta2" value="written to a store (green)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="f_legend"><mxGeometry x="648" y="90" width="160" height="20" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Retention&lt;/b&gt; — VictoriaMetrics, VictoriaLogs, VictoriaTraces and Pyroscope keep 7 days. ClickHouse keeps the same traces and logs for 90 days (7 days on the hot volume, then the RustFS cold volume), which is where a question older than a week goes. The edge access logs reach ClickHouse only: the VictoriaLogs leg drops them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="400" y="700" width="420" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
