        <mxCell id="separate" value="&lt;b&gt;Access boundaries&lt;/b&gt;&lt;br&gt;The LAN column is independent recovery, not a Tailscale Operator feature. A remote Talos/LAN route is still an open design. Access IdP is not selected; the Keycloak card represents application identity only. No WARP is required." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1015" width="900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="policy" value="&lt;b&gt;Publication and authorization&lt;/b&gt;&lt;br&gt;This view follows private web access. Explicit public web routes are a separate allowlist decision and retain application auth. Management APIs and datastores have no public Tunnel route. Selected private services need their own tailnet restrictions; this view shows the Kubernetes API path." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1087" width="900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="origin" value="&lt;b&gt;Origin and recovery gates&lt;/b&gt;&lt;br&gt;Validate Access tokens at cloudflared or the origin; preserve Host/SNI and TLS verification. Review forwarded headers and admin CIDR trust. Recovery credentials and LAN procedures must work without connectors or in-cluster identity." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1159" width="900" height="60" as="geometry" />
        </mxCell>
