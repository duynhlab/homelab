          <mxGeometry x="635" y="51" width="270" height="78" as="geometry" />
        </mxCell>
        <mxCell id="switch" value="&lt;b&gt;Managed switch&lt;/b&gt;&lt;br&gt;L2 • Ethernet frames / MAC forwarding&lt;br&gt;planned" style="rounded=1;dashed=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="osi2">
          <mxGeometry x="25" y="41" width="270" height="78" as="geometry" />
        </mxCell>
        <mxCell id="vlan" value="&lt;b&gt;VLAN separation&lt;/b&gt;&lt;br&gt;L2 • IDs / trunks / access ports open&lt;br&gt;planned" style="rounded=1;dashed=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#4C1D95;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="osi2">
          <mxGeometry x="335" y="41" width="270" height="78" as="geometry" />
        </mxCell>
        <mxCell id="nic" value="&lt;b&gt;NIC data-link function&lt;/b&gt;&lt;br&gt;L2 • Ethernet frames on each host&lt;br&gt;planned" style="rounded=1;dashed=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#4C1D95;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="osi2">
          <mxGeometry x="635" y="41" width="270" height="78" as="geometry" />
        </mxCell>
        <mxCell id="wire" value="&lt;b&gt;Ethernet cabling&lt;/b&gt;&lt;br&gt;L1 • physical medium / link signals&lt;br&gt;planned" style="rounded=1;dashed=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#334155;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="osi1">
          <mxGeometry x="25" y="41" width="270" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ports" value="&lt;b&gt;NIC PHY and switch ports&lt;/b&gt;&lt;br&gt;L1 • transceivers / link speed open&lt;br&gt;planned" style="rounded=1;dashed=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#4C1D95;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="osi1">
          <mxGeometry x="335" y="41" width="270" height="78" as="geometry" />
        </mxCell>
        <mxCell id="hosts" value="&lt;b&gt;Mini-PC network links&lt;/b&gt;&lt;br&gt;L1 • node 1, then nodes 2–3&lt;br&gt;planned" style="rounded=1;dashed=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#4C1D95;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="osi1">
          <mxGeometry x="635" y="41" width="270" height="78" as="geometry" />
        </mxCell>
        <mxCell id="reading" value="&lt;b&gt;Read by network function&lt;/b&gt;&lt;br&gt;L1 carries bits; L2 forwards frames; L3 routes IP; L4 carries TCP/UDP; L5–L7 describe session, representation and application functions. These OSI numbers differ from the five hosting bands in the stack preview. The physical and access views own connectivity and request paths." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1510" width="970" height="60" as="geometry" />
        </mxCell>
        <mxCell id="span" value="&lt;b&gt;Products span layers&lt;/b&gt;&lt;br&gt;Tailscale carries IP at L3 over WireGuard, normally using UDP; relays may carry encrypted traffic when direct connectivity is unavailable. Its API proxy is L7. The depicted Cloudflare web proxy uses an outbound Tunnel connection: QUIC/UDP 7844 or HTTP/2/TCP 7844. No inbound management port forwarding is proposed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1582" width="970" height="60" as="geometry" />
        </mxCell>
        <mxCell id="homelab" value="&lt;b&gt;Tailscale homelab choices&lt;/b&gt;&lt;br&gt;A supported host can run its own client. A subnet router extends access to selected LAN CIDRs; route approval and access policy are separate requirements. An Operator Connector can provide that router, but an in-cluster connector is not independent recovery. API proxy and subnet routing are separate roles, not consecutive mandatory hops." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1654" width="970" height="60" as="geometry" />
        </mxCell>
        <mxCell id="open" value="&lt;b&gt;Not yet selected&lt;/b&gt;&lt;br&gt;No VLAN IDs, subnets, addresses, firewall implementation or CNI routing mode are chosen. A switch may also support L3 features, but none are selected here. L5/L6 are teaching analogies for modern protocols, not claims of dedicated OSI implementations. Cilium L7 policy is not selected by this view." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1726" width="970" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legend" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;html=1;container=1;collapsible=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#334155;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=left;spacingLeft=10;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1816" width="970" height="66" as="geometry" />
        </mxCell>
        <mxCell id="legend-role-planned" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;shadow=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="legend">
          <mxGeometry x="14" y="38" width="26" height="14" as="geometry" />
        </mxCell>
        <mxCell id="legend-role-planned-text" value="planned (not deployed)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#334155;" vertex="1" parent="legend">
