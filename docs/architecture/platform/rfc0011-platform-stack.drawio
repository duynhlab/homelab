        </mxCell>
        <mxCell id="reading" value="&lt;b&gt;How to read the stack&lt;/b&gt;&lt;br&gt;Read upward from hardware. Cards name installed-software candidates, not packet paths or pod placement. Domain rows inside layer 04 are peers. Dashed + planned means uninstalled on mini PCs, not an approved decision." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="2090" width="1170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="choices" value="&lt;b&gt;Open choices and capacity&lt;/b&gt;&lt;br&gt;Node 1 starts the rollout; nodes 2–3 are later expansion, not a claim of HA. Hardware, sizing, OS, CNI and storage remain open. Ubuntu + k3s is the OS fallback. Ceph and local persistence are alternatives; RustFS is the existing object-store baseline. Native database backups and restore gates remain required." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="2142" width="1170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="palette" value="&lt;b&gt;Role colours&lt;/b&gt;&lt;br&gt;Blue: edge • cyan: applications • amber: workers • purple: controllers • green: data. Observability: orange metrics, pale green logs, teal traces, violet profiles, light blue collectors." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="2214" width="1170" height="40" as="geometry" />
        </mxCell>
