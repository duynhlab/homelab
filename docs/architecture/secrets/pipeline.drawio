        <mxCell id="scope" value="How a secret travels from OpenBao to the pods that use it, what keeps OpenBao unsealed and configured, how the notification database password rotates, and where the edge certificate and the homelab CA go. Local Kind only; the production cluster runs no secrets stack yet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
