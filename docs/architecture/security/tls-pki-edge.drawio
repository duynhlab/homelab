        <mxCell id="title" value="duynhlab homelab — TLS: PKI, edge and east-west (Kind, as deployed)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1330" height="28" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="Who issues each certificate, and which request, identity and east-west hops are encrypted and verified. The hop state is written on every edge: TLS verified / TLS unverified / PLAINTEXT / planned. Database, pooler and store hops are in tls-data-tier; the full per-hop list is the §12.1 table in docs/secrets/cert-manager.md. local-stack is plaintext by design and is not drawn." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1330" height="36" as="geometry" />
