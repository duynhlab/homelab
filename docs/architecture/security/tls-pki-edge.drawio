        </mxCell>
        <mxCell id="d_eso" value="PLAINTEXT&#10;SA JWT + reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=1;endArrow=classic;fontFamily=Helvetica;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="eso" target="bao">
          <mxGeometry relative="1" as="geometry" x="-0.37">
