        <mxCell id="c_unseal" value="PLAINTEXT · awskms seal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=1;endArrow=classic;fontFamily=Helvetica;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;endSize=6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bao" target="floci">
          <mxGeometry relative="1" as="geometry" x="0" />
        </mxCell>
        <mxCell id="d_oci" value="PLAINTEXT · OCI pull&#10;insecure · no cosign" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=1;endArrow=classic;fontFamily=Helvetica;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;endSize=6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fluxop" target="registry">
          <mxGeometry relative="1" as="geometry" x="0.1">
            <Array as="points">
              <mxPoint x="650" y="1162" />
              <mxPoint x="650" y="1162" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note_state" value="&lt;b&gt;Reading the hop state&lt;/b&gt;&lt;br&gt;TLS verified: the client checks the chain against a CA and checks the hostname. TLS unverified: the hop is encrypted, but the client does not check who answers. PLAINTEXT: nothing is encrypted on the hop. Behind the edge every request, identity and east-west hop is plaintext: Envoy has no BackendTLSPolicy, Keycloak serves HTTP in-cluster, gRPC between services uses insecure credentials, and OpenBao runs tls_disable. Only the two OIDC hairpins (OpenBao, Flux web UI) verify, against the live homelab-ca. Operator-managed TLS (OpenBao Raft cluster port, Envoy Gateway xDS, chart webhook Issuers) uses each operator's own CA. kubelet and kube-apiserver scrapes use TLS with insecureSkipVerify." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1270" width="1330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note_planned" value="&lt;b&gt;Planned, not installed (RFC-0020, provisional)&lt;/b&gt;&lt;br&gt;S0 edge issuer decouple · S1 OpenBao listener TLS · S6 gRPC + Temporal mTLS · S7 intermediate CA · S8 Keycloak HTTPS · S10 Envoy BackendTLSPolicy · S13 OCI registry TLS + cosign · S14 KMS over HTTPS (production). S2–S4 shipped through ADR-089 and are drawn in tls-data-tier." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="1352" width="1330" height="60" as="geometry" />
        </mxCell>
