          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"keycloak\",uri=~\"/realms/.*\"}[$__rate_interval])) by (le))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
