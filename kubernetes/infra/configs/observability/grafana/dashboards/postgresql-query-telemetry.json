          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(ts) AS time, 100.0 * sum(shared_blks_hit) / greatest(sum(shared_blks_hit) + sum(shared_blks_read), 1) AS v FROM pg_stat_ch.events_raw WHERE $__timeFilter(ts) AND db_name IN (${db_name:singlequote}) AND app IN (${app:singlequote}) GROUP BY time ORDER BY time",
