            "uid": "${ds}"
          },
          "editorType": "sql",
          "rawSql": "SELECT query_id, db_name, db_operation, countMerge(calls_state) AS calls, round(sumMerge(duration_sum_state)/1e6, 2) AS total_s, round(100 * sumMerge(duration_sum_state) / (SELECT sumMerge(duration_sum_state) FROM pg_stat_ch.query_stats_5m WHERE $__timeFilter(bucket) AND db_name IN (${db_name:singlequote})), 2) AS pct_runtime, round(arrayElement(quantilesTDigestMerge(0.5, 0.95, 0.99)(duration_q_state), 1)/1000, 2) AS p50_ms, round(arrayElement(quantilesTDigestMerge(0.5, 0.95, 0.99)(duration_q_state), 2)/1000, 2) AS p95_ms, round(arrayElement(quantilesTDigestMerge(0.5, 0.95, 0.99)(duration_q_state), 3)/1000, 2) AS p99_ms, sumMerge(errors_sum_state) AS errors, round(100.0 * sumMerge(shared_hit_sum_state) / greatest(sumMerge(shared_hit_sum_state) + sumMerge(shared_read_sum_state), 1), 1) AS hit_pct, anyMerge(query_text_state) AS query_text FROM pg_stat_ch.query_stats_5m WHERE $__timeFilter(bucket) AND db_name IN (${db_name:singlequote}) GROUP BY query_id, db_name, db_operation ORDER BY total_s DESC LIMIT 25",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.22.1"
