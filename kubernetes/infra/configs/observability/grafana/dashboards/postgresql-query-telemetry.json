    {
      "id": 3,
      "type": "stat",
      "title": "Statements/s",
      "description": "Average executions per second over the range (all selected databases).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "rawSql": "SELECT $__timeInterval(ts) AS time, count()/$__interval_s AS v FROM pg_stat_ch.events_raw WHERE $__timeFilter(ts) AND db_name IN (${db_name:singlequote}) AND app IN (${app:singlequote}) GROUP BY time ORDER BY time",
          "format": 1,
          "queryType": "timeseries",
          "pluginVersion": "4.22.1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
