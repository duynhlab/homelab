        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Temporal on the cluster, both halves: SDK/worker metrics (temporal_*) pushed over OTLP by the workers through the collector, and server metrics (service_*, persistence_*, approximate_backlog_*) scraped via the four per-role ServiceMonitors the official temporalio chart renders (job=~\".*temporal.*\"). Metric names verified against a live temporal server 1.31.2 on the compose stack, 2026-08-18. The namespace variable defaults to mop, which keeps the server's internal system workflows (namespace temporal_system) out of the SDK panels. Local twin: local-stack/observability/grafana/dashboards/Observability/temporal-local.json (uid temporal-worker-local).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Workflows",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "id": 2,
      "type": "timeseries",
      "title": "Workflow completion rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(temporal_workflow_completed_total{namespace=~\"$namespace\",service_name=~\"$service_name\",workflow_type=~\"$workflow_type\"}[$__rate_interval])) by (workflow_type, service_name)",
          "range": true,
          "refId": "A",
          "legendFormat": "{{workflow_type}} ({{service_name}})"
        }
      ],
      "description": "SDK counter temporal_workflow_completed_total (bare name — the Go SDK exports counters without _total; verified live 2026-08-18)."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "id": 3,
      "type": "timeseries",
      "title": "Workflow failure ratio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(temporal_workflow_failed_total{namespace=~\"$namespace\",service_name=~\"$service_name\",workflow_type=~\"$workflow_type\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(temporal_workflow_completed_total{namespace=~\"$namespace\",service_name=~\"$service_name\",workflow_type=~\"$workflow_type\"}[$__rate_interval])) + (sum(rate(temporal_workflow_failed_total{namespace=~\"$namespace\",service_name=~\"$service_name\",workflow_type=~\"$workflow_type\"}[$__rate_interval])) or vector(0)), 1)",
          "range": true,
          "refId": "A",
          "legendFormat": "failure ratio"
        }
      ],
      "description": "temporal_workflow_failed_total is failure-only: it has NO series until a workflow fails, so the numerator carries `or vector(0)` — a healthy stack reads 0, not 'No data'."
    },
