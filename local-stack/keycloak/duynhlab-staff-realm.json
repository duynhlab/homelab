{
  "realm": "duynhlab-staff",
  "enabled": true,
  "registrationAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "eventsListeners": ["jboss-logging"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "groups": [
    {
      "name": "infra-team",
      "path": "/infra-team"
    },
    {
      "name": "sre-team",
      "path": "/sre-team"
    },
    {
      "name": "dev-team",
      "path": "/dev-team"
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "backoffice_admin",
        "description": "May access protected business APIs (RFC-0023 / ADR-050)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "admin-portal",
      "name": "Backoffice Admin Portal (RFC-0023, staff realm per ADR-050)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:3009/*"
      ],
      "webOrigins": [
        "http://localhost:3009"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "duynhlab-platform",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "grafana",
      "name": "Grafana (staff SSO per ADR-062; compose secret is a dev-only placeholder)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "grafana-local-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3002/login/generic_oauth"
      ],
      "webOrigins": [
        "http://localhost:3002"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "flux-web",
      "name": "Flux Operator web UI (staff SSO per ADR-062; no flux runs in compose - realm parity only, dev-only placeholder secret)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "flux-web-local-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:9080/oauth2/callback"
      ],
      "webOrigins": [
        "http://localhost:9080"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "openbao",
      "name": "OpenBAO (staff SSO per ADR-062; no OpenBAO in local-stack — shape parity only, dev-only placeholder secret)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "openbao-local-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8200/ui/vault/auth/oidc/oidc/callback",
        "http://localhost:8250/oidc/callback"
      ],
      "webOrigins": [
        "http://localhost:8200"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "d0e00000-0000-4000-8000-000000000001",
      "username": "duyne",
      "email": "duyne@example.com",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "p@ss1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "backoffice_admin"
      ],
      "groups": [
        "/infra-team"
      ],
      "firstName": "Duy",
      "lastName": "Ne",
      "requiredActions": []
    }
  ]
}
