<!-- ClickHouse's built-in Prometheus endpoint (:9363/metrics), the engine's
     own view of itself: system.metrics (gauges), system.events (counters),
     system.asynchronous_metrics (periodic samples), and system.errors as
     ClickHouseErrorMetric_* — the local stand-in for the alert the cluster
     derives from the Altinity exporter's system_errors series.

     Key set verified against current server docs: metrics / events /
     asynchronous_metrics / errors. (status_info existed in older servers and
     is gone — do not re-add it.)

     The cluster now enables this endpoint too (RFC-0028): at one shard × one
     replica the Altinity metrics-exporter's /chi carried the engine signals
     there and a second scrape would have duplicated them, but with three
     replicas the per-pod series are what say WHICH replica is sick — and
     ClickHouseMetrics_ReadonlyReplica has no equivalent in the exporter's
     view at all. Locally there is no operator and no exporter, so this
     endpoint is the only engine view, which is why it was enabled here first.
     Local-stack stays single-node with no keeper: the divergence is
     deliberate, and the exporter's cluster options are cluster-only values. -->
<clickhouse>
  <prometheus>
    <endpoint>/metrics</endpoint>
    <port>9363</port>
    <metrics>true</metrics>
    <events>true</events>
    <asynchronous_metrics>true</asynchronous_metrics>
    <errors>true</errors>
  </prometheus>
  <!-- 26.8+: per-device async metrics are Map metrics; `both` also keeps the
       old scalar names (ClickHouseAsyncMetrics_DiskAvailable_default ...) that
       the vmalert rules read. Same setting as the cluster CHI. -->
  <asynchronous_metrics_key_values_mode>both</asynchronous_metrics_key_values_mode>
</clickhouse>
