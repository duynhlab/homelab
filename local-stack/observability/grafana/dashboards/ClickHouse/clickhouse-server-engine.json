  "description": "ClickHouse server/engine health from the Altinity metrics-exporter (/chi) and operator (/metrics) \u2014 the engine-side complement of the OTel data-plane dashboards, which query the data over the SQL datasource instead.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Server",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "stat",
      "title": "Up",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "1 - clamp_max(chi_clickhouse_metric_fetch_errors, 1)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "up{job=\"clickhouse\"}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Cluster: 1 = the Altinity exporter fetched system tables on the last scrape. Local: a genuine scrape of the server's own endpoint."
    },
