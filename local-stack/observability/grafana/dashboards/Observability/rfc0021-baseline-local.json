  "description": "RFC-0021 overhaul baseline: the pre-refactor signals every cutover gate is judged against (CP-0 requires 7 days of data). All queries read rfc0021:* recording rules.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Checkout confirm — read-path cutover gate",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Confirm success vs bounce (per second)",
      "description": "Confirmed sessions vs re-validation bounces (PRICE_CHANGED/STOCK_UNAVAILABLE). The availability-source cutover must not grow the bounce line.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rfc0021:checkout_confirm_success:rate5m",
          "legendFormat": "confirmed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rfc0021:checkout_confirm_bounce:rate5m",
          "legendFormat": "bounced (requoted)",
          "refId": "B"
        }
      ]
    },
